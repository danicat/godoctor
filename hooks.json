{
  "godoctor-hooks": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${PLUGIN_ROOT}/hooks/godoctor-hook.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
